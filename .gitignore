# Runtime config and secrets — APP_KEY / DATA_DIR live outside the checkout
# (see README). Never commit these.
.env
.env.*
!.env.example
handoff.env
*.env
!*.env.example

# Credential store and local data dirs
data/
**/sessions/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Logs and temp output (e2e / php -S / local sweeps)
*.log
*.tmp
tmp/
/tmp/

# PHP / Composer (if added later)
vendor/
.phpunit.result.cache
.php-cs-fixer.cache
.phpstan.cache

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
